{
  "name": "sylenth1",
  "description": "Sylenth1 .fxp dump (cleaned_dataset.npy). 182 continuous + 32 binary + 29 categorical native keys.",
  "version": "1.0",
  "detect": {
    "required_keys": [
      "AmpEnv A Attack",
      "AmpEnv A Decay",
      "Filter A Cutoff",
      "Osc A1 Waveform"
    ]
  },
  "params": {
    "osc_1_waveform":     { "strategy": "direct",          "key": "Osc A1 Waveform", "default": 0.0 },
    "osc_2_waveform":     { "strategy": "direct",          "key": "Osc A2 Waveform", "default": 0.0 },
    "osc_mix":            { "strategy": "direct",          "key": "Osc A2 Volume",   "default": 0.0 },
    "osc_2_detune":       { "strategy": "direct",          "key": "Osc A2 Detune",   "default": 0.0 },
    "noise_level":        { "strategy": "max",             "keys": ["Osc B1 Volume", "Osc B2 Volume"], "default": 0.0 },
    "filter_cutoff":      { "strategy": "direct",          "key": "Filter A Cutoff", "default": 0.5 },
    "filter_resonance":   { "strategy": "direct",          "key": "Filter A Reso",   "default": 0.0 },
    "filter_type":        { "strategy": "direct",          "key": "Filter A Type",   "default": 0.0 },
    "amp_attack":         { "strategy": "direct",          "key": "AmpEnv A Attack", "default": 0.0 },
    "amp_decay":          { "strategy": "direct",          "key": "AmpEnv A Decay",  "default": 0.3 },
    "amp_sustain":        { "strategy": "direct",          "key": "AmpEnv A Sustain","default": 0.8 },
    "amp_release":        { "strategy": "direct",          "key": "AmpEnv A Release","default": 0.3 },
    "filter_env_amount":  { "strategy": "bipolar_amount",  "key": "xModEnv1 Dest1Am","default": 0.5 },
    "filter_env_decay":   { "strategy": "direct",          "key": "ModEnv 1 Decay",  "default": 0.3 },
    "lfo_rate":           { "strategy": "direct",          "key": "LFO 1 Rate",      "default": 0.3 },
    "lfo_to_pitch":       { "strategy": "routed_amount",   "amount_key": "xModLFO1 Dest1Am", "dest_key": "yModLFO1 Dest1", "expected_dest": 0.0, "tolerance": 0.05, "default": 0.0 },
    "lfo_to_cutoff":      { "strategy": "direct",          "key": "LFO 1 Gain",      "default": 0.0 },
    "velocity_to_filter": { "strategy": "direct",          "key": "FilterCtl KeyTrk","default": 0.0 },
    "distortion_mix":     { "strategy": "gated",           "value": "Distort DryWet","gate": "Sw DistOnOff",   "default": 0.0 },
    "reverb_mix":         { "strategy": "gated",           "value": "Reverb Dry/Wet","gate": "Sw ReverbOnOff", "default": 0.0 }
  }
}
